<Window x:Class="Hoshiko.XAML.MediaPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hoshiko.XAML"
        mc:Ignorable="d"
        Title="MediaPlayerWindow" Height="450" Width="1000">

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <MediaElement x:Name="MediaElement"
                      Grid.Row="0" Grid.Column="0"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      ScrubbingEnabled="True"
                      Stretch="Uniform" />

        <Slider x:Name="PositionSlider"
        Grid.Row="1" Grid.Column="0"
        Minimum="0"
        Maximum="100"
        Value="0"
        SmallChange="0.1"
        Margin="8,4"
        IsMoveToPointEnabled="True"
        ValueChanged="PositionSlider_ValueChanged"
        HorizontalAlignment="Stretch" />

        <Grid Grid.Row="2" Grid.Column="0"
      Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton"
            Content="Play"
            Width="80" Height="24"
            Margin="0,0,8,0"
            Click="PlayPauseButton_Click"
            Grid.Column="0" />

            <Slider x:Name="VolumeSlider"
            Margin="4,6,4,6"
            Minimum="0"
            Maximum="1"
            Value="0.8"
            SmallChange="0.05"
            IsMoveToPointEnabled="True"
            ValueChanged="VolumeSlider_ValueChanged"
            HorizontalAlignment="Stretch"
            Grid.Column="1" />
        </Grid>

        <ListView x:Name="Playlist"
          Grid.Row="0"
          Grid.RowSpan="3"
          Grid.Column="1"
          Margin="8"
          Background="Transparent"
          BorderBrush="LightGray"
          BorderThickness="1"
          SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                        Content="Play"
                        Margin="8,0,0,0"
                        Padding="4,1"
                        Width="50"
                        Click="PlayItemButton_Click"
                        CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Window>