<Window x:Class="Hoshiko.XAML.MediaPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hoshiko.XAML"
        mc:Ignorable="d"
        Title="MediaPlayerWindow" Height="450" Width="800">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaElement x:Name="MediaElement"
              Grid.Row="0"
              LoadedBehavior="Manual"
              UnloadedBehavior="Stop"
              ScrubbingEnabled="True"
              Stretch="Uniform" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,4">
            <Button x:Name="PlayPauseButton"
                    Content="Play"
                    Width="80" Height="24"
                    Margin="0,0,8,0"
                    Click="PlayPauseButton_Click" />

            <Slider x:Name="PositionSlider"
                    Margin="4,6,4,6"
                    TickFrequency="1"
                    IsMoveToPointEnabled="True"
                    ValueChanged="PositionSlider_ValueChanged" Width="685" />
        </StackPanel>

        <Slider x:Name="VolumeSlider"
                Grid.Row="2"
                Minimum="0"
                Maximum="1"
                Value="0.8"
                SmallChange="0.05"
                Margin="8,4"
                IsMoveToPointEnabled="True"
                ValueChanged="VolumeSlider_ValueChanged" />
    </Grid>
</Window>
