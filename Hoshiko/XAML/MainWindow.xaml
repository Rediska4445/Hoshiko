<Window x:Class="Hoshiko.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hoshiko"
        xmlns:pages="clr-namespace:Hoshiko.XAML"
        mc:Ignorable="d"
        Title="Hoshiko – стриминговая платформа" Height="600" Width="900">

    <Grid Margin="10">
        <TabControl>

            <TabItem Header="Фильмы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                   Text="Список фильмов" 
                   FontWeight="Bold" 
                   Margin="0,0,0,5"/>

                    <ListView Grid.Row="1"
                  Name="MoviesList"
                  ItemsSource="{Binding Movies}"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="0,0,0,10">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                Content="Воспроизвести"
                                Margin="10,0,0,0"
                                Padding="8,4"
                                Command="{Binding Path=DataContext.PlayMovieCommand, 
                                                 RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="2" 
                        Text="Рекомендуемые фильмы" 
                        FontWeight="Bold" 
                        Margin="0,10,0,5"
                        Visibility="{Binding IsChecked, ElementName=ShowMoviesRecommendations}"/>

                    <ListView Grid.Row="3" 
                        Name="RecommendedMoviesList"
                        ItemsSource="{Binding RecommendedMovies}"
                        SelectedItem="{Binding SelectedRecommendedMovie}"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsChecked, ElementName=ShowMoviesRecommendations}">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                        Content="Воспроизвести"
                                        Margin="10,0,0,0"
                                        Padding="8,4"
                                        Command="{Binding Path=DataContext.PlayMovieCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                        CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </TabItem>

            <TabItem Header="Сериалы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                   Text="Список сериалов" 
                   FontWeight="Bold" 
                   Margin="0,0,0,5"/>

                    <ListView Grid.Row="1"
                          Name="SeriesList"
                          ItemsSource="{Binding Series}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,10">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                Content="Смотреть"
                                Margin="10,0,0,0"
                                Command="{Binding Path=DataContext.PlaySeriesCommand, 
                                                 RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="2" 
                       Text="Рекомендуемые сериалы" 
                       FontWeight="Bold" 
                       Margin="0,10,0,5"
                       Visibility="{Binding IsChecked, ElementName=ShowSeriesRecommendations}"/>

                    <ListView Grid.Row="3" 
                          Name="RecommendedSeriesList"
                          ItemsSource="{Binding RecommendedSeries}"
                          SelectedItem="{Binding SelectedRecommendedSeries}"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsChecked, ElementName=ShowSeriesRecommendations}">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                        Content="Смотреть"
                                        Margin="10,0,0,0"
                                        Padding="8,4"
                                        Command="{Binding Path=DataContext.PlaySeriesCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                        CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Музыка">
                <Grid Margin="10" 
                       VerticalAlignment="Stretch"
                       MaxHeight="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=ActualHeight, ConverterParameter=100}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="41*"/>
                        <ColumnDefinition Width="386*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                       Grid.Row="0"
                       Text="Список треков"
                       FontWeight="Bold"
                       Margin="0,0,0,5" Grid.ColumnSpan="2" />

                    <ListView
                        Grid.Row="1"
                        Name="MusicList"
                        ItemsSource="{Binding Musics}"
                        HorizontalContentAlignment="Stretch"
                                            ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,10" Grid.ColumnSpan="2">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                       Grid.Column="0"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center" />

                                    <Button
                                       Grid.Column="1"
                                       Content="Воспроизвести"
                                       Margin="10,0,0,0"
                                       Command="{Binding Path=DataContext.PlayMusicCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                       CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                       Grid.Row="2"
                       Text="Рекомендуемая музыка"
                       FontWeight="Bold"
                       Margin="0,10,0,5" Grid.ColumnSpan="2" />

                    <ListView
                        Grid.Row="3"
                        Name="RecommendedMusicList"
                        ItemsSource="{Binding RecommendedMusics}"
                        SelectedItem="{Binding SelectedRecommendedMusic}"
                        HorizontalContentAlignment="Stretch"
                                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Grid.ColumnSpan="2">    

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding Title}"
                                        VerticalAlignment="Center" />

                                    <Button
                                        Grid.Column="1"
                                        Content="Воспроизвести"
                                        Margin="10,0,0,0"
                                        Command="{Binding Path=DataContext.PlayMusicCommand, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                        CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>


                </Grid>
            </TabItem>

            <TabItem Header="Телепередачи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Программа телепередач" 
                       FontWeight="Bold" 
                       FontSize="16" 
                       VerticalAlignment="Center"/>

                        <ComboBox Name="ChannelFilterComboBox" 
                      Width="180" 
                      Height="25"
                      HorizontalAlignment="Right" 
                      Margin="10,0,0,0"
                      ItemsSource="{Binding Channels}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedChannel}"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" 
                      Name="TvScheduleGrid"
                      ItemsSource="{Binding TvPrograms}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" 
                                    Binding="{Binding StartTime, StringFormat=\{0:HH:mm\}}" 
                                    Width="60" 
                                    FontWeight="SemiBold"/>

                            <DataGridTextColumn Header="Название передачи" 
                                    Binding="{Binding Title}" 
                                    Width="*"/>

                            <DataGridTextColumn Header="Канал" 
                                    Binding="{Binding ChannelName}" 
                                    Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Жанры">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Жанры фильмов" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ListView Grid.Row="1"
                                      Name="MovieGenresList"
                                      ItemsSource="{Binding MovieGenres}"
                                      SelectedItem="{Binding SelectedMovieGenre}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Grid Grid.Column="1" Margin="5,0,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Жанры сериалов" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ListView Grid.Row="1"
                                      Name="SeriesGenresList" 
                                      ItemsSource="{Binding SeriesGenres}"
                                      SelectedItem="{Binding SelectedSeriesGenre}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Grid Grid.Column="2" Margin="5,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Жанры музыки" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ListView Grid.Row="1" 
                                      Name="MusicGenresList" 
                                      ItemsSource="{Binding MusicGenres}"
                                      SelectedItem="{Binding SelectedMusicGenre}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="1" 
                   Text="Любимые жанры" 
                   FontWeight="Bold" 
                   Margin="0,5,0,5"/>

                    <ListView Grid.Row="2" 
                      Name="FavoriteGenresList" 
                      ItemsSource="{Binding FavoriteGenres}"
                      SelectedItem="{Binding SelectedFavoriteGenre}"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="3"
                            Margin="0,15,0,0"
                            Orientation="Horizontal">
                        <Button Content="Добавить в избранное" 
                            Command="{Binding AddToFavoriteCommand}" 
                            Margin="0,0,10,0" 
                            Padding="10,5"/>
                        <Button Content="Удалить из избранного" 
                            Command="{Binding RemoveFromFavoriteCommand}" 
                            Margin="0,0,10,0" 
                            Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>