<Window x:Class="Hoshiko.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hoshiko"
        xmlns:pages="clr-namespace:Hoshiko.XAML"
        mc:Ignorable="d"
        Title="Hoshiko – стриминговая платформа" Height="600" Width="900">

    <Grid Margin="10">
        <TabControl>

            <!-- 1. Вкладка "Фильмы" -->
            <TabItem Header="Фильмы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Список фильмов" FontWeight="Bold" Margin="0,0,0,5"/>

                    <ListView Grid.Row="1"
                          Name="MoviesList"
                          ItemsSource="{Binding Movies}">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Title}"
                                        VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                        Content="Воспроизвести"
                                        Margin="10,0,0,0"
                                        Padding="8,4"
                                        Command="{Binding Path=DataContext.PlayMovieCommand, 
                                                          RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                        CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="3" 
                          Visibility="{Binding 
                              IsChecked, 
                              ElementName=ShowMoviesRecommendations}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Рекомендуемые фильмы" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListView Grid.Row="1" Name="RecommendedMoviesList"
                                  Height="100"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- 2. Вкладка "Сериалы" -->
            <TabItem Header="Сериалы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Список сериалов" FontWeight="Bold" Margin="0,0,0,5"/>

                    <ListView Grid.Row="1"
                          Name="SeriesList"
                          ItemsSource="{Binding Series}">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Title}"
                                        VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                        Content="Смотреть"
                                        Margin="10,0,0,0"
                                         Command="{Binding Path=DataContext.PlaySeriesCommand, 
                                                          RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                        CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="3" 
                          Visibility="{Binding 
                              IsChecked, 
                              ElementName=ShowSeriesRecommendations}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Рекомендуемые сериалы" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListView Grid.Row="1" Name="RecommendedSeriesList"
                                  Height="100"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- 3. Вкладка "Музыка" -->
            <TabItem Header="Музыка">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Список треков" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListView Grid.Row="1"
                          Name="MusicList"
                          ItemsSource="{Binding Musics}">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Title}"
                                     VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                    Content="Воспроизвести"
                                    Margin="10,0,0,0"
                                      Command="{Binding Path=DataContext.PlayMusicCommand, 
                                                        RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                      CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="3" 
                          Visibility="{Binding 
                              IsChecked, 
                              ElementName=ShowMusicRecommendations}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Рекомендуемая музыка" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListView Grid.Row="1" Name="RecommendedMusicList"
                                  Height="100"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- 4. Вкладка "Жанры" -->
            <TabItem Header="Жанры">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Вверху — три списка жанров -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Жанры фильмов -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                           Text="Жанры фильмов"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                            <ListView Grid.Row="1"
                          Name="MovieGenresList"
                          ItemsSource="{Binding MovieGenres}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Жанры сериалов -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                           Text="Жанры сериалов"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                            <ListView Grid.Row="1"
                          Name="SeriesGenresList"
                          ItemsSource="{Binding SeriesGenres}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Жанры музыки -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                           Text="Жанры музыки"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                            <ListView Grid.Row="1"
                          Name="MusicGenresList"
                          ItemsSource="{Binding MusicGenres}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <!-- Внизу — кнопки управления жанрами -->
                    <StackPanel Grid.Row="1"
                    Margin="0,10,0,0"
                    Orientation="Horizontal">

                        <Button Content="Добавить в любимые"
                    Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранный"
                    Margin="0,0,10,0"/>
                        <Button Content="Сохранить" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>