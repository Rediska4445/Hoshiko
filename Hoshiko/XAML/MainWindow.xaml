<Window x:Class="Hoshiko.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hoshiko"
        xmlns:pages="clr-namespace:Hoshiko.XAML"
        mc:Ignorable="d"
        Title="Hoshiko – стриминговая платформа" Height="600" Width="900">

    <Grid Margin="10">
        <TabControl>

            <!-- 1. Вкладка "Фильмы" -->
            <TabItem Header="Фильмы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Список фильмов" FontWeight="Bold" Margin="0,0,0,5"/>

                    <ListView Grid.Row="1" Name="MoviesList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Title}"
                                        VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                        Content="Воспроизвести"
                                        Margin="10,0,0,0"
                                        Padding="8,4"
                                        Click="MoviePlayButton_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="3" 
                          Visibility="{Binding 
                              IsChecked, 
                              ElementName=ShowMoviesRecommendations}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Рекомендуемые фильмы" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListView Grid.Row="1" Name="RecommendedMoviesList"
                                  Height="100"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- 2. Вкладка "Сериалы" -->
            <TabItem Header="Сериалы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Список сериалов" FontWeight="Bold" Margin="0,0,0,5"/>

                    <ListView Grid.Row="1" Name="SeriesList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}"/>
                                    <Button Grid.Column="1" Content="Посмотреть эпизоды" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="3" 
                          Visibility="{Binding 
                              IsChecked, 
                              ElementName=ShowSeriesRecommendations}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Рекомендуемые сериалы" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListView Grid.Row="1" Name="RecommendedSeriesList"
                                  Height="100"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- 3. Вкладка "Музыка" -->
            <TabItem Header="Музыка">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Список треков" FontWeight="Bold" Margin="0,0,0,5"/>

                    <ListView Grid.Row="1" Name="MusicList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}"/>
                                    <Button Grid.Column="1" Content="Воспроизвести" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="3" 
                          Visibility="{Binding 
                              IsChecked, 
                              ElementName=ShowMusicRecommendations}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Рекомендуемая музыка" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ListView Grid.Row="1" Name="RecommendedMusicList"
                                  Height="100"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- 4. Вкладка "Жанры" -->
            <TabItem Header="Жанры">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Все жанры" FontWeight="Bold" Margin="0,0,0,5"/>

                    <ComboBox Grid.Row="1" 
                              Name="GenresBox" 
                              Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Text="Ваши любимые жанры" FontWeight="Bold" Margin="0,10,0,5"/>

                    <ListView Grid.Row="3" Name="FavoriteGenresList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"/>
                                    <Button Grid.Column="1" Content="Удалить" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="4" 
                                Margin="0,10,0,0" 
                                Orientation="Horizontal">
                        <Button Content="Добавить в любимые" 
                                Margin="0,0,10,0"/>
                        <Button Content="Удалить выбранный" 
                                Margin="0,0,10,0"/>
                        <Button Content="Сохранить" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>